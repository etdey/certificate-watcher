{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Certificate Watcher",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/src/certificate_watcher/cli.py",
            "args": [
                "--argsExpand",
                "${input:cliArgs}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "cliArgs",
            "type": "promptString",
            "description": "Arguments (shell-style quoting; leave blank for none)",
            "default": ""
        }
    ]
}